# Makefile - rmtplay: RMT module player for the PC (SDL2)
#
# The player routine is the Atari one (../../src/rmtplayr.s, same as
# PokeyATest/src; ../../src/lzsplayr.s for a .sap / .xex exported by RITMO):
# ca65 assembles it at a fixed address, the binary is embedded in rmtplay and
# runs on a 6502 emulator.
#
# rmtplay -c64 plays as the Commodore 64 does (../../../rmt_cbm64): the same
# routines assembled with -D RMT_C64, plus sidrmt.s (POKEY -> SID) and the
# SID frequency tables of that project, on a SID emulation.
#
#   make                      build ./rmtplay
#   ./rmtplay ../../music/gemx.rmt
#   ./rmtplay ../../music/gemx.sap
#   ./rmtplay -c64 ../../music/gemx.rmt
#   make check                the player copies of RmtSkeleton, PokeyATest
#                             and rmt_cbm64 must be the same
#   make clean

CC      ?= gcc
CFLAGS  ?= -O2 -Wall -Wextra
SDL_CFLAGS := $(shell sdl2-config --cflags)
SDL_LIBS   := $(shell sdl2-config --libs)

C64     = ../../../rmt_cbm64
ATARI   = ../../../PokeyATest
BUILD   = build

all: check rmtplay

# the three projects keep their own copy of the player: warn when they differ
check:
	@for f in rmtplayr.s lzsplayr.s rmt_feat.inc; do \
	   for d in $(ATARI)/src $(C64)/src; do \
	     cmp -s ../../src/$$f $$d/$$f || \
	       echo "warning: ../../src/$$f and $$d/$$f differ (rmtplay -c64 uses $(C64)/src)"; \
	   done; \
	 done

# four builds of the player, each a raw binary at $A000 plus its addresses
# as a C header (build/<name>_bin.h, binhdr.awk):
#   atari_rmt  ../../src/rmtplayr.s
#   atari_lzs  ../../src/lzsplayr.s (.sap / .xex)
#   c64_rmt    $(C64)/src/rmtplayr.s -D RMT_C64 + sidrmt.s + SID tables
#   c64_lzs    $(C64)/src/lzsplayr.s -D RMT_C64 + sidrmt.s + SID tables
# sidrmt.s with -g: the label file then has pokey_to_sid, ispeed, line_lo ..
BUILDS = atari_rmt atari_lzs c64_rmt c64_lzs

$(BUILD)/atari_rmtplayr.o: ../../src/rmtplayr.s ../../src/rmt_feat.inc
	@mkdir -p $(BUILD)
	ca65 -I ../../src -o $@ $<

$(BUILD)/atari_lzsplayr.o: ../../src/lzsplayr.s
	@mkdir -p $(BUILD)
	ca65 -o $@ $<

$(BUILD)/c64_rmtplayr.o: $(C64)/src/rmtplayr.s $(C64)/src/rmt_feat.inc
	@mkdir -p $(BUILD)
	ca65 -D RMT_C64 -I $(C64)/src -o $@ $<

$(BUILD)/c64_lzsplayr.o: $(C64)/src/lzsplayr.s
	@mkdir -p $(BUILD)
	ca65 -D RMT_C64 -o $@ $<

$(BUILD)/c64_sidrmt.o: $(C64)/src/sidrmt.s
	@mkdir -p $(BUILD)
	ca65 -g -o $@ $<

$(BUILD)/c64_sidtab.s: $(C64)/tools/mksidtab.py
	@mkdir -p $(BUILD)
	python3 $< $@

$(BUILD)/%.o: $(BUILD)/%.s
	ca65 -o $@ $<

$(BUILD)/lzstracks.o: lzstracks.s
	@mkdir -p $(BUILD)
	ca65 -o $@ $<

SID_OBJS = $(BUILD)/c64_sidrmt.o $(BUILD)/c64_sidtab.o

$(BUILD)/atari_rmt.bin: $(BUILD)/atari_rmtplayr.o rmtplay.cfg
	ld65 -C rmtplay.cfg -o $@ -Ln $(@:.bin=.lbl) $(filter %.o,$^)
$(BUILD)/atari_lzs.bin: $(BUILD)/atari_lzsplayr.o $(BUILD)/lzstracks.o rmtplay.cfg
	ld65 -C rmtplay.cfg -o $@ -Ln $(@:.bin=.lbl) $(filter %.o,$^)
$(BUILD)/c64_rmt.bin: $(BUILD)/c64_rmtplayr.o $(SID_OBJS) rmtplay_c64.cfg
	ld65 -C rmtplay_c64.cfg -o $@ -Ln $(@:.bin=.lbl) $(filter %.o,$^)
$(BUILD)/c64_lzs.bin: $(BUILD)/c64_lzsplayr.o $(BUILD)/lzstracks.o $(SID_OBJS) rmtplay_c64.cfg
	ld65 -C rmtplay_c64.cfg -o $@ -Ln $(@:.bin=.lbl) $(filter %.o,$^)

# player binary + addresses as a C header
$(BUILD)/%_bin.h: $(BUILD)/%.bin binhdr.awk
	@( P=$$(echo $* | tr a-z A-Z); \
	   echo "/* generated by the Makefile - do not edit */"; \
	   awk -v P=$$P -f binhdr.awk $(BUILD)/$*.lbl; \
	   echo "static const unsigned char $*_bin[] = {"; \
	   od -An -v -tx1 $< | sed 's/ *\([0-9a-f][0-9a-f]\)/0x\1,/g'; \
	   echo "};" ) > $@

SRCS = rmtplay.c cpu6502.c pokey.c sid.c

rmtplay: $(SRCS) cpu6502.h pokey.h sid.h $(BUILDS:%=$(BUILD)/%_bin.h)
	$(CC) $(CFLAGS) $(SDL_CFLAGS) -I$(BUILD) -o $@ $(SRCS) $(SDL_LIBS)

clean:
	rm -rf $(BUILD) rmtplay

.PHONY: all check clean
