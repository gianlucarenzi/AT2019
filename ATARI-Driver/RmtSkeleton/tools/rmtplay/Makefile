# Makefile - rmtplay: RMT module player for the PC (SDL2)
#
# The player routine is the Atari one (../../src/rmtplayr.s, same as
# PokeyATest/src): ca65 assembles it at a fixed address, the binary is
# embedded in rmtplay and runs on a 6502 emulator.
#
#   make                      build ./rmtplay
#   ./rmtplay ../../music/gemx.rmt
#   make clean

CC      ?= gcc
CFLAGS  ?= -O2 -Wall -Wextra
SDL_CFLAGS := $(shell sdl2-config --cflags)
SDL_LIBS   := $(shell sdl2-config --libs)

PLAYER  = ../../src/rmtplayr.s
BUILD   = build

all: rmtplay

$(BUILD)/rmtplayr.o: $(PLAYER) ../../src/rmt_feat.inc
	@mkdir -p $(BUILD)
	ca65 -I ../../src -o $@ $(PLAYER)

$(BUILD)/rmtplayr.bin $(BUILD)/rmtplayr.lbl: $(BUILD)/rmtplayr.o rmtplay.cfg
	ld65 -C rmtplay.cfg -o $(BUILD)/rmtplayr.bin -Ln $(BUILD)/rmtplayr.lbl $<

# player binary + entry points as a C header
$(BUILD)/rmtplayr_bin.h: $(BUILD)/rmtplayr.bin $(BUILD)/rmtplayr.lbl
	@( echo "/* generated by the Makefile from $(PLAYER) - do not edit */"; \
	   echo "#define RMT_BASE 0xA000"; \
	   echo "#define RMT_END (RMT_BASE + sizeof(rmtplayr_bin))"; \
	   awk '$$3 == ".RASTERMUSICTRACKER" { print "#define RMT_ENTRY 0x" substr($$2, 3) } \
	        $$3 == ".rmt_ioactive" { print "#define RMT_IOACTIVE 0x" substr($$2, 3) }' $(BUILD)/rmtplayr.lbl; \
	   echo "static const unsigned char rmtplayr_bin[] = {"; \
	   od -An -v -tx1 $(BUILD)/rmtplayr.bin | sed 's/ *\([0-9a-f][0-9a-f]\)/0x\1,/g'; \
	   echo "};" ) > $@

rmtplay: rmtplay.c cpu6502.c pokey.c cpu6502.h pokey.h $(BUILD)/rmtplayr_bin.h
	$(CC) $(CFLAGS) $(SDL_CFLAGS) -I$(BUILD) -o $@ rmtplay.c cpu6502.c pokey.c $(SDL_LIBS)

clean:
	rm -rf $(BUILD) rmtplay

.PHONY: all clean
